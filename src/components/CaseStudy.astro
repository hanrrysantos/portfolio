---
import { Image } from "astro:assets"
import { BookOpen } from "@lucide/astro"
import GithubIcon from "@/components/GithubIcon.astro"
import LinkArrow from "@/components/LinkArrow.astro"
import { accentBg, accentText, type Project } from "@/data/site"

interface Props {
  project: Project
  flip?: boolean
}

const { project, flip = false } = Astro.props
const text = accentText[project.accent]
const bg = accentBg[project.accent]
const [primary, ...secondary] = project.links
---

<article
  id={project.slug}
  class="container-page grid items-center gap-10 py-14 md:py-20 lg:grid-cols-2 lg:gap-16 lg:py-24"
>
  <div class:list={["relative", flip && "lg:order-2"]}>
    <p class="flex items-center gap-3">
      <span class:list={["font-marker text-3xl leading-none md:text-4xl", text]}>{project.number}</span>
      <span aria-hidden="true" class:list={["h-0.5 w-8 shrink-0 md:w-10", bg]}></span>
      <span class="text-xs font-semibold tracking-[0.14em] text-cinza uppercase md:text-sm">{project.category}</span>
    </p>
    <h3 data-reveal="chars" class="mt-3 font-marker text-[clamp(3rem,13vw,5.5rem)] leading-none uppercase">{project.name}</h3>

    <p data-reveal="up" class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-300 md:text-xl">{project.summary}</p>

    <div class="mt-8 max-w-xl">
      <p class="text-xs font-semibold tracking-[0.14em] text-cinza uppercase">Decisões técnicas</p>
      <ol class="mt-3 divide-y divide-line border-y border-line">
        {project.decisions.map((decision, i) => (
          <li data-reveal="up" class="flex gap-4 py-4">
            <span class:list={["w-6 shrink-0 text-sm leading-6 font-bold tabular-nums", text]}>{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="leading-6 font-semibold text-giz">{decision.title}</p>
              <p class="mt-1 text-[15px] leading-snug text-cinza">{decision.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <ul data-reveal="up" class="mt-6 flex flex-wrap gap-2" aria-label="Stack">
      {project.stack.map((tool) => (
        <li class="rounded-full border border-line bg-ink-2 px-3 py-1 text-sm font-medium text-zinc-300">{tool}</li>
      ))}
    </ul>

    <div data-reveal="up" class="mt-8 flex flex-wrap gap-3">
      <a href={primary.href} target="_blank" rel="noopener" data-magnetic class:list={["group inline-flex items-center gap-3 rounded-full py-2 pr-2 pl-6 font-bold text-ink", bg]}>
        {primary.label} <LinkArrow class:list={["size-9 bg-ink", text]} />
      </a>
      {secondary.map((link) => (
        <a href={link.href} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 rounded-full border-[1.5px] border-[#3a3c46] px-5 py-3.5 font-medium transition-colors hover:border-giz">
          {link.href.includes("github.com") ? <GithubIcon class="size-4" /> : link.href.includes("swagger") ? <BookOpen class="size-4" /> : <LinkArrow class="size-5" />}
          {link.label}
        </a>
      ))}
    </div>
  </div>

  <div class:list={["relative", flip && "lg:order-1"]}>
    {project.media.kind === "polaroid" ? (
      <div class="relative px-2 py-6 md:px-6">
        <div data-parallax class:list={["relative rounded-md bg-giz p-2 shadow-[0_20px_40px_#00000088] md:p-2.5", flip ? "-rotate-2" : "rotate-2"]}>
          <Image src={project.media.image} alt={project.media.alt} widths={[480, 720, 1100]} sizes="(min-width: 1024px) 40rem, 92vw" class="w-full rounded-sm" />
          <span aria-hidden="true" class="absolute -top-4 left-6 h-7 w-24 -rotate-6 bg-giz/70 backdrop-blur-sm"></span>
          <span aria-hidden="true" class="absolute -top-3 right-8 h-7 w-24 rotate-[8deg] bg-giz/70 backdrop-blur-sm"></span>
        </div>
        {project.stamp && (
          <span
            data-stamp
            aria-hidden="true"
            class:list={["absolute -right-1 -bottom-4 grid size-24 -rotate-12 place-items-center rounded-full text-center font-marker text-base leading-none whitespace-pre-line text-ink md:size-32 md:text-xl", bg]}
          >
            {project.stamp}
          </span>
        )}
      </div>
    ) : (
      <div class="relative mx-auto flex max-w-md items-start justify-center py-6 lg:max-w-none">
        <div aria-hidden="true" class:list={["absolute top-1/2 left-1/2 aspect-square w-[85%] -translate-1/2 rounded-full", bg]}></div>
        {project.media.images.map((shot, i) => (
          <div
            data-parallax={i === 0 ? "slow" : "fast"}
            class:list={[
              "relative rounded-[1.75rem] border-2 border-line bg-black p-1.5 shadow-[0_20px_40px_#00000099] md:p-2",
              i === 0 ? "z-10 mt-8 w-[46%] rotate-6" : "-ml-6 w-[37%] -rotate-[5deg]",
            ]}
          >
            <div class="flex aspect-[9/16] flex-col overflow-hidden rounded-[1.25rem]">
              {/* status bar: a ilha não cobre o topo do print; o resto da tela mostra o topo do print e corta o fim */}
              <div aria-hidden="true" class="relative flex h-6 shrink-0 items-center px-[9%] text-[9px] font-semibold text-ink md:h-7 md:text-[10px]" style={{ backgroundColor: shot.bar }}>
                9:41
                <span class="absolute top-1/2 left-1/2 h-[60%] w-[30%] -translate-1/2 rounded-full bg-black"></span>
              </div>
              <Image src={shot.image} alt={shot.alt} widths={[280, 420]} sizes="(min-width: 1024px) 20rem, 45vw" class="min-h-0 w-full flex-1 object-cover object-top" />
            </div>
          </div>
        ))}
      </div>
    )}
    <p data-reveal="up" class:list={["mt-4 -rotate-3 text-center font-hand text-[1.75rem] leading-none whitespace-pre-line lg:mt-6", text]}>{project.note}</p>
  </div>
</article>
